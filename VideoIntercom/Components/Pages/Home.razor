@page "/"
@rendermode InteractiveServer
@using System.Timers
@using VideoIntercom
@implements IDisposable
@inject IJSRuntime JS
@inject IntercomStreamService Intercom

<PageTitle>Видеодомофон — живой поток</PageTitle>

<div class="intercom-player">
    <h1 class="h4 mb-3">Видеодомофон</h1>

    <div class="video-wrap">
        <video id="intercomVideo" class="w-100" muted autoplay playsinline></video>
        <div id="videoOverlay" class="video-overlay" hidden>Подключение к домофону…</div>
    </div>

    <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
        <span class="badge @StatusBadgeClass">@Status</span>
        <span class="text-body-secondary small">кадров: @string.Format("{0:N0}", FramesTotal)</span>
        <span class="text-body-secondary small">@(TimeSinceLastFrame is null ? "нет кадров" : $"последний кадр {TimeSinceLastFrame.Value.TotalSeconds:0.0} с назад")</span>
    </div>
</div>

@code {
    private string? Status;
    private long FramesTotal;
    private TimeSpan? TimeSinceLastFrame;
    private System.Timers.Timer? _timer;

    private string StatusBadgeClass => Status switch
    {
        "Подключено" => "text-bg-success",
        null => "text-bg-secondary",
        _ when Status.StartsWith("Подключено") => "text-bg-success",
        _ => "text-bg-warning"
    };

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;

        _ = JS.InvokeVoidAsync("intercomPlayer.start",
            "intercomVideo", "videoOverlay", 0, 12);

        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += (_, _) => InvokeAsync(RefreshStatus);
        _timer.Start();
    }

    private void RefreshStatus()
    {
        Status = Intercom.Status;
        FramesTotal = Intercom.FramesTotal;
        TimeSinceLastFrame = Intercom.LastFrameUtc is { } t ? DateTime.UtcNow - t : null;
        StateHasChanged();
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }
}
